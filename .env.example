# PostgreSQL connection details
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapidb

# Optional: full override URL (takes precedence if set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapidb

# Dev convenience flags
AUTO_CREATE_DATABASE=true   # Creates the DB if it doesn't exist
AUTO_CREATE_TABLES=true     # Creates tables on startup (good for local dev)